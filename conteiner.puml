@startuml conteiner
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

TITLE Diagrama de Contêineres - Sistema BovinoMotor

Person(produtor, "Produtor Rural", "Acessa o sistema via navegador web ou dispositivo móvel.")

System_Boundary(bovinomotor_sys, "BovinoMotor") {
    Container(web_app, "Interface Web", "HTML5, CSS3, JavaScript", "Interface gráfica interativa para entrada de dados de pesagem e insumos.")
    Container(backend, "Servidor Backend", "Python, Flask", "Processa as regras de negócio, cálculo de arrobas, manejo e autenticação.")
    ContainerDb(database, "Banco de Dados", "SQLite / PostgreSQL", "Armazena dados de usuários, lotes, pesagens e insumos.")
}

Rel(produtor, web_app, "Utiliza", "HTTPS")
Rel(web_app, backend, "Faz requisições HTTP / API REST", "JSON")
Rel(backend, database, "Lê e escreve dados", "SQL")

@enduml