@startuml Container_BoviMonitor
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

Person(usuario, "Usuário", "Pecuarista ou Capataz")

System_Boundary(boviBoundary, "Sistema BoviMonitor") {
    Container(webApp, "Aplicação Web / Mobile", "HTML, CSS, JavaScript", "Telas simples e intuitivas para cadastro de lotes e visualização de alertas.")
    Container(api, "API Backend", "Python / Flask", "Processa regras de negócio, cálculo de carência e validação de vacinas.")
    ContainerDb(database, "Banco de Dados", "PostgreSQL / SQLite", "Armazena dados de lotes, pastos, vacinas e histórico de aplicações.")
}

Rel(usuario, webApp, "Acessa e digita dados", "HTTPS")
Rel(webApp, api, "Faz chamadas de API (JSON)", "HTTPS")
Rel(api, database, "Lê e grava dados", "SQL / ORM")

@enduml
