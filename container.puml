@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

Person(produtor, "Produtor Rural", "Usuário que gerencia a pesagem e insumos no campo.")

System_Boundary(sistema_agro, "Sistema de Gestão Agro") {
    Container(web_app, "Aplicação Web", "HTML / CSS / JS", "Interface para o produtor cadastrar pesagens e visualizar relatórios.")
    Container(backend, "Servidor Backend", "Python / Flask", "Processa regras de negócio, como cálculo de arrobas e estoque.")
    ContainerDb(banco, "Banco de Dados", "SQLite / PostgreSQL", "Guarda os registros de pesagem, insumos e usuários.")
}

Rel(produtor, web_app, "Acessa e digita dados em", "HTTPS")
Rel(web_app, backend, "Envia requisições de API para", "JSON / HTTP")
Rel(backend, banco, "Consulta e grava informações em", "SQL")

@enduml