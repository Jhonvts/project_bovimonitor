@startuml Fluxo_Manejo_Carencia
start

:Capataz seleciona o Lote no curral;
:Informa a vacina ou remédio aplicado;
:Informa a Data da Aplicação;

if (É medicamento com carência?) then (sim)
  :Sistema busca os 'Dias de Carência' do remédio;
  :Data de Liberação = Data da Aplicação + Dias de Carência;
  :Sinaliza Lote como 'BLOQUEADO PARA VENDA';
else (não / vacina comum)
  :Registra aplicação no histórico sanitário;
endif

:Verifica se é vacina obrigatória (Aftosa/Brucelose);
if (Aftosa ou Brucelose?) then (sim)
  :Atualiza o Calendário Sanitário para 'APLICADA';
  :Remove alerta de pendência fiscal;
endif

:Exibe resumo do Manejo e Status Atualizado do Lote;

stop
@enduml
