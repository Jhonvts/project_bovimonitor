# Copie para .env e troque os valores antes de iniciar.
SECRET_KEY=troque-por-uma-chave-aleatoria-longa
ADMIN_EMAIL=admin@exemplo.local
ADMIN_INITIAL_PASSWORD=troque-por-uma-senha-forte
DATABASE_URL=sqlite:///bovimonitor.db
FLASK_DEBUG=0
SESSION_COOKIE_SECURE=0
# Use 1 somente atrás de um proxy reverso confiável com exatamente um salto.
TRUST_PROXY=0
